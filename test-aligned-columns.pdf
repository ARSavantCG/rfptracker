          <div>
            <div class="info-item"><span class="label">RFP Number:</span><span class="value">RFP-2025-005</span></div>
            <div class="info-item"><span class="label">Project Name:</span><span class="value">Oakley & Sons 3 @ MG Westside - A</span></div>
            <div class="info-item"><span class="label">Tenant:</span><span class="value">Oakley & Sons 3</span></div>
          </div>
          <div>
            <div class="info-item"><span class="label">Property:</span><span class="value">5</span></div>
            <div class="info-item"><span class="label">Development Contact:</span><span class="value">Adolfo Reutlinger - Bridge Industrial</span></div>
            <div class="info-item"><span class="label">Report Date:</span><span class="value">Monday, June 16, 2025</span></div>
          </div>
        </div>
      </div>

      <!-- Detailed Line Item Tables -->
      
      <div class="section">
        <div class="section-header">
